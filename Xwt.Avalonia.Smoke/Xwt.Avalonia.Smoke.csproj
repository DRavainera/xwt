<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Xwt.AvaloniaBackend.Smoke</RootNamespace>
    <AssemblyName>Xwt.Avalonia.Smoke</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct references: Avalonia's buildTransitive targets expect the
         AvaloniaBuildTasks task assembly resolved in the consuming exe. -->
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <ProjectReference Include="..\Xwt.Avalonia\Xwt.Avalonia.csproj" />
  </ItemGroup>

  <Target Name="_EnsureAvaloniaBuildTasksLocation"
          BeforeTargets="PreBuildEvent;Build">
    <!-- Fallback: transitive Avalonia imports (via the Xwt.Avalonia
         ProjectReference) can evaluate AvaloniaBuildTasksLocation before the
         package props that define it; pin it to the global-packages layout. -->
    <PropertyGroup Condition="'$(AvaloniaBuildTasksLocation)' == ''">
      <AvaloniaBuildTasksLocation>$(NuGetPackageRoot)avalonia\12.1.2\tools\netstandard2.0\Avalonia.Build.Tasks.dll</AvaloniaBuildTasksLocation>
    </PropertyGroup>
  </Target>

</Project>
